    "/internal/authorization/check": {
      "post": {
        "operationId": "InternalAuthorizationController_check",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckAuthorizationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "DecisiÃ³n actual, allowed true o false; no constituye permiso permanente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "subject_id",
                    "action",
                    "resource_id",
                    "allowed",
                    "reason"
                  ],
                  "properties": {
                    "subject_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "steganography.analyze",
                        "steganography.results.read"
                      ]
                    },
                    "resource_id": {
                      "type": "string",
                      "format": "uuid",
                      "nullable": true
                    },
                    "allowed": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "active_role_grants_permission",
                        "active_role_does_not_grant_permission"
                      ]
                    }
                  }
                },
                "examples": {
                  "permitido": {
                    "value": {
                      "subject_id": "87d1619e-af9e-4f57-84f2-f93f04690812",
                      "action": "steganography.analyze",
                      "resource_id": null,
                      "allowed": true,
                      "reason": "active_role_grants_permission"
                    }
                  },
                  "denegado": {
                    "value": {
                      "subject_id": "87d1619e-af9e-4f57-84f2-f93f04690812",
                      "action": "steganography.analyze",
                      "resource_id": null,
                      "allowed": false,
                      "reason": "active_role_does_not_grant_permission"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entrada o parÃ¡metro invÃ¡lido",
