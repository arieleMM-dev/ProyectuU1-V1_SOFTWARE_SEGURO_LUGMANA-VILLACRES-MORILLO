  "info": {
    "title": "AUTH Backend V1",
    "description": "",
    "version": "2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "ServiceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "cedula": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          },
          "nombres": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "apellidos": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "fechaNacimiento": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "username": {
            "type": "string",
            "minLength": 4,
            "maxLength": 50,
            "pattern": "^[a-z0-9._-]+$"
          },
          "email": {
            "type": "string",
            "maxLength": 150,
            "format": "email"
          },
          "telefono": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "estado": {
            "type": "boolean"
          }
        },
        "required": [
          "cedula",
          "nombres",
          "apellidos",
          "fechaNacimiento",
          "username",
          "email",
          "telefono",
          "password"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cedula": {
            "type": "string"
          },
          "nombres": {
            "type": "string"
          },
          "apellidos": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "telefono": {
            "type": "string"
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "estado": {
            "type": "boolean"
          },
          "tokenVersion": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time"
          },
          "fechaActualizacion": {
            "type": "string",
            "format": "date-time"
          },
          "fechaEliminacion": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "userRoles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Assignment"
            }
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "rol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "estado": {
            "type": "boolean"
          },
          "version": {
            "type": "integer"
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time"
          },
          "fechaActualizacion": {
            "type": "string",
            "format": "date-time"
