                  "requestId": "ejemplo-auth"
                }
              }
            }
          },
          "401": {
            "description": "Servicio, canal o token de usuario invÃ¡lido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                },
                "example": {
                  "statusCode": 401,
                  "message": "Credenciales, sesiÃ³n o identidad de servicio invÃ¡lidas",
                  "timestamp": "2026-11-04T12:00:00.000Z",
                  "path": "/internal/authorization/check",
                  "requestId": "ejemplo-auth"
                }
              }
            }
          },
          "413": {
